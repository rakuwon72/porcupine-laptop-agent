# Copy this file to ".env" and put your real key in it.
ANTHROPIC_API_KEY=your-key-here

# ---- Phone control (optional; see the top of phone.py for the 3-minute setup) ----
# TELEGRAM_BOT_TOKEN=token-from-BotFather
# TELEGRAM_ALLOWED_USER_IDS=123456789      # YOUR numeric id (find it with: python phone.py --whoami)
# PHONE_PIN=choose-a-secret-pin            # strongly recommended
# PHONE_CONFIRM=true                       # risky actions ask yes/no on your phone
# PHONE_AUTOSTART=true                     # start phone control together with the porcupine

# Optional: change the model without touching code.
MODEL_NAME=claude-haiku-5-5
